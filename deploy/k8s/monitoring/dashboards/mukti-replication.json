{
  "uid": "mukti-replication",
  "title": "MUKTI - Replication Lag",
  "tags": ["mukti", "replication", "multi-region"],
  "style": "dark",
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Replication Lag p95",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 2},
            {"color": "red", "value": 10}
          ]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(mukti_replication_lag_seconds_bucket[5m])) by (le))"
      }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Check Success Rate",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "orange", "value": 0.5},
            {"color": "green", "value": 0.99}
          ]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{
        "expr": "sum(rate(mukti_replication_checks_total{status=\"success\"}[5m])) / sum(rate(mukti_replication_checks_total[5m]))"
      }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pending Markers",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 5},
            {"color": "red", "value": 20}
          ]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "mukti_replication_pending_markers"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Writer Available",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "mappings": [{"type": "value", "options": {
            "0": {"text": "DOWN", "color": "red"},
            "1": {"text": "UP", "color": "green"}
          }}]
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "mukti_replication_writer_available"}]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Reader Available",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "fieldConfig": {
        "defaults": {
          "mappings": [{"type": "value", "options": {
            "0": {"text": "DOWN", "color": "red"},
            "1": {"text": "UP", "color": "green"}
          }}]
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "mukti_replication_reader_available"}]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Replication Lag Percentiles",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 15, "lineWidth": 2}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "calcs": ["mean", "max"]}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(mukti_replication_lag_seconds_bucket[5m])) by (le))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum(rate(mukti_replication_lag_seconds_bucket[5m])) by (le))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum(rate(mukti_replication_lag_seconds_bucket[5m])) by (le))", "legendFormat": "p99"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Replication Checks by Status",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "fillOpacity": 70, "stacking": {"mode": "normal"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}},
      "targets": [
        {"expr": "sum(rate(mukti_replication_checks_total[5m])) by (status)", "legendFormat": "{{status}}"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Catch-up Lag (post-outage markers)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 20}}, "overrides": []},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(mukti_replication_catchup_seconds_bucket[15m])) by (le))", "legendFormat": "catchup p95"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Pending Markers Over Time (replication backlog)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 40}}, "overrides": []},
      "targets": [
        {"expr": "mukti_replication_pending_markers", "legendFormat": "pending"}
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      }
    ]
  }
}
