{
  "uid": "mukti-slo",
  "title": "MUKTI - SLO Error Budget",
  "tags": ["mukti", "slo", "error-budget"],
  "style": "dark",
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-30d", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability (30d) vs Target 99.9%",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "orange", "value": 0.998},
            {"color": "green", "value": 0.999}
          ]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "1 - mukti_slo:availability_error_ratio:ratio30d"}]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Error Budget Remaining",
      "gridPos": {"h": 8, "w": 5, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "orange", "value": 0.25},
            {"color": "green", "value": 0.5}
          ]}
        },
        "overrides": []
      },
      "options": {"showThresholdLabels": false, "showThresholdMarkers": true, "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "mukti_slo:error_budget_remaining:ratio30d"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Budget Consumed",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 4},
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "orange", "value": 0.75}, {"color": "red", "value": 0.9}
      ]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "mukti_slo:error_budget_consumed:ratio30d"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Projected Days Until Exhaustion",
      "gridPos": {"h": 8, "w": 5, "x": 9, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null}, {"color": "orange", "value": 7}, {"color": "green", "value": 30}
          ]}
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{
        "expr": "mukti_slo:error_budget_remaining:ratio30d / clamp_min(deriv(mukti_slo:error_budget_consumed:ratio30d[6h]), 1e-12) / 86400"
      }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "📉 Error Budget Burn-Down (30d window)",
      "gridPos": {"h": 9, "w": 14, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {"drawStyle": "line", "fillOpacity": 30, "lineWidth": 2}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "list"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "mukti_slo:error_budget_remaining:ratio30d", "legendFormat": "budget remaining"},
        {"expr": "1 - (time() - (time() - 30*24*3600)) / (30*24*3600) * 0 + 0.9999999 - 1 + 1", "hide": true}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Current Burn Rates (1h / 6h / 3d)",
      "gridPos": {"h": 8, "w": 10, "x": 14, "y": 0},
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null}, {"color": "red", "value": 1}
          ]}
        },
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "calcs": ["mean", "max"]}},
      "targets": [
        {"expr": "mukti_slo:availability_error_ratio:rate1h / 0.001", "legendFormat": "1h burn rate"},
        {"expr": "mukti_slo:availability_error_ratio:rate6h / 0.001", "legendFormat": "6h burn rate"},
        {"expr": "mukti_slo:availability_error_ratio:rate3d / 0.001", "legendFormat": "3d burn rate"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Error Rate vs SLO Budget (0.1%)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17},
      "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"drawStyle": "line", "fillOpacity": 20}}, "overrides": []},
      "targets": [
        {"expr": "mukti_slo:availability_error_ratio:rate5m", "legendFormat": "error rate (5m)"},
        {"expr": "0.001", "legendFormat": "error budget rate (0.1%)"}
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "All SLOs – Status",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "targets": [
        {"expr": "1 - mukti_slo:availability_error_ratio:ratio30d", "legendFormat": "availability (99.9%)", "instant": true, "format": "table"},
        {"expr": "1 - mukti_slo:latency_slow_ratio:rate1h", "legendFormat": "latency (99% < 2s)", "instant": true, "format": "table"}
      ]
    }
  ],
  "links": [
    {"title": "Cache & Failover", "type": "link", "url": "/d/mukti-cache-failover"},
    {"title": "Replication", "type": "link", "url": "/d/mukti-replication"}
  ]
}
