{
  "uid": "mukti-slo-deploy",
  "title": "MUKTI - SLO Deploy & Rollback",
  "tags": ["mukti", "slo", "deploy", "rollback"],
  "style": "dark",
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "enable": true,
        "expr": "changes(mukti_postdeploy_last_deploy_timestamp_seconds[2m]) > 0",
        "iconColor": "#FFA500",
        "titleFormat": "Deploy",
        "textFormat": "New deployment rolled out"
      },
      {
        "name": "Rollbacks",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "enable": true,
        "expr": "changes(mukti_postdeploy_rollbacks_total[2m]) > 0",
        "iconColor": "#FF0000",
        "titleFormat": "Rollback",
        "textFormat": "Deployment rolled back"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Last Validation",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "mappings": [{"type": "value", "options": {
            "0": {"text": "FAIL", "color": "red"},
            "1": {"text": "PASS", "color": "green"}
          }}]
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "mukti_postdeploy_last_validation_passed"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Validations Run",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "sum(mukti_postdeploy_validations_total)"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rollbacks",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "sum(mukti_postdeploy_rollbacks_total)"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Current Revision",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "mukti_postdeploy_current_revision"}]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Time Since Last Deploy",
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "time() - mukti_postdeploy_last_deploy_timestamp_seconds"}]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error Rate (with deploy/rollback markers)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"drawStyle": "line", "fillOpacity": 20, "lineWidth": 2}}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "mukti_slo:availability_error_ratio:rate5m", "legendFormat": "error rate (5m)"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Error Rate: Before vs After Last Deploy",
      "description": "Blue = current, orange = 1 hour ago (pre-deploy baseline).",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "mukti_slo:availability_error_ratio:rate5m", "legendFormat": "after (current)"},
        {"expr": "mukti_slo:availability_error_ratio:rate5m offset 1h", "legendFormat": "before (1h ago)"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Validation Error Rates (baseline vs measured)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}},
      "targets": [
        {"expr": "mukti_postdeploy_baseline_error_rate", "legendFormat": "baseline (pre-deploy)"},
        {"expr": "mukti_postdeploy_after_error_rate", "legendFormat": "after (post-deploy)"}
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Latency p95 (deploy-aware)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 15}}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"mukti-api\"}[5m])) by (le))", "legendFormat": "p95"}
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Budget Burn-Down (30d)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"drawStyle": "line", "fillOpacity": 30}}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}},
      "targets": [
        {"expr": "mukti_slo:error_budget_remaining:ratio30d", "legendFormat": "budget remaining"}
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Validation Outcomes (by result)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "targets": [
        {"expr": "sum by (result) (mukti_postdeploy_validations_total)", "instant": true, "format": "table", "legendFormat": "{{result}}"}
      ]
    }
  ],
  "links": [
    {"title": "SLO Error Budget", "type": "link", "url": "/d/mukti-slo"},
    {"title": "Cache & Failover", "type": "link", "url": "/d/mukti-cache-failover"}
  ]
}
