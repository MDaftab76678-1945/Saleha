{
  "uid": "mukti-drills",
  "title": "MUKTI - DR Drills",
  "tags": ["mukti", "chaos", "drills"],
  "style": "dark",
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-7d", "to": "now"},
  "annotations": {
    "list": [
      {
        "name": "Drills Active",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "enable": true,
        "expr": "mukti_drill_active == 1",
        "iconColor": "#FF9800",
        "titleFormat": "DRILL",
        "textFormat": "Chaos drill in progress"
      },
      {
        "name": "Drill Runs",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "enable": true,
        "expr": "changes(mukti_drill_last_run_timestamp_seconds[1h]) > 0",
        "iconColor": "#2196F3",
        "titleFormat": "Drill completed"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Drill In Progress",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "mappings": [{"type": "value", "options": {
            "0": {"text": "IDLE", "color": "green"},
            "1": {"text": "ACTIVE", "color": "orange"}
          }}]
        },
        "overrides": []
      },
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "mukti_drill_active"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Drills Passed (7d)",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "sum(increase(mukti_drill_runs_total{result=\"pass\"}[7d]))"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Drills Failed (7d)",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "sum(increase(mukti_drill_runs_total{result=\"fail\"}[7d]))"}]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg Recovery Time",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["mean"]}},
      "targets": [{"expr": "avg(mukti_drill_recovery_seconds)"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error Rate During Drills",
      "description": "Error rate with drill annotations – correlate spikes with chaos",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"drawStyle": "line", "fillOpacity": 20}}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum(rate(http_requests_total{job=\"mukti-api\",status=~\"5..\"}[2m])) / sum(rate(http_requests_total{job=\"mukti-api\"}[2m]))", "legendFormat": "error rate"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Recovery Time by Drill",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "calcs": ["mean", "max"]}},
      "targets": [
        {"expr": "mukti_drill_recovery_seconds", "legendFormat": "{{drill}}"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Phase Durations",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "bars", "fillOpacity": 60}}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}},
      "targets": [
        {"expr": "mukti_drill_phase_duration_seconds", "legendFormat": "{{drill}}/{{phase}}"}
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Drill Run History",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "sum by (drill, result) (increase(mukti_drill_runs_total[7d]))", "instant": true, "format": "table"}
      ]
    }
  ],
  "templating": {
    "list": [
      {"name": "datasource", "label": "Data source", "type": "datasource", "query": "prometheus", "hide": 0}
    ]
  },
  "links": [
    {"title": "Replication", "type": "link", "url": "/d/mukti-replication"},
    {"title": "Cache & Failover", "type": "link", "url": "/d/mukti-cache-failover"}
  ]
}
