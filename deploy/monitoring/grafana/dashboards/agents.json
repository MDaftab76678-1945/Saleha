{
  "dashboard": {
    "id": null,
    "title": "MUKTI Agents Dashboard",
    "tags": ["mukti", "agents"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "type": "stat",
        "title": "Active Agents",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [{
          "expr": "count(agent_status{status=\"active\"})",
          "legendFormat": "Active"
        }],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 10},
                {"color": "green", "value": 50}
              ]
            }
          }
        }
      },
      {
        "type": "stat",
        "title": "Tasks Completed (24h)",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [{
          "expr": "sum(increase(agent_tasks_completed_total[24h]))"
        }]
      },
      {
        "type": "stat",
        "title": "Avg Latency (ms)",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [{
          "expr": "histogram_quantile(0.50, sum(rate(agent_task_duration_seconds_bucket[5m])) by (le)) * 1000"
        }]
      },
      {
        "type": "stat",
        "title": "Error Rate",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [{
          "expr": "sum(rate(agent_tasks_failed_total[5m])) / sum(rate(agent_tasks_total[5m])) * 100"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "green", "value": 0},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 5}
              ]
            }
          }
        }
      },
      {
        "type": "timeseries",
        "title": "Tasks per Minute",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [{
          "expr": "sum(rate(agent_tasks_completed_total[1m])) by (agent_type)",
          "legendFormat": "{{agent_type}}"
        }]
      },
      {
        "type": "timeseries",
        "title": "Token Usage",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [{
          "expr": "sum(rate(llm_tokens_used_total[5m])) by (model)",
          "legendFormat": "{{model}}"
        }]
      },
      {
        "type": "timeseries",
        "title": "LLM Cost (USD/hour)",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [{
          "expr": "sum(rate(llm_cost_usd_total[1h])) by (model)",
          "legendFormat": "{{model}}"
        }]
      },
      {
        "type": "bargauge",
        "title": "Top Agents by Tasks",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [{
          "expr": "topk(10, sum(increase(agent_tasks_completed_total[24h])) by (agent_id))",
          "legendFormat": "{{agent_id}}"
        }]
      }
    ]
  }
}
