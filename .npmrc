# The workspace packages are declared as plain "*" ranges (e.g. "@saleha/ui": "*")
# so that npm and yarn can resolve them from the "workspaces" field. pnpm does not
# link a plain semver range to a local workspace package by default, so it tried to
# fetch @saleha/ui from the public registry and failed with a 404. This setting
# makes pnpm prefer the local workspace package for those ranges.
link-workspace-packages=true
