{
  "name": "saleha-ai-vscode",
  "displayName": "Saleha AI - Autonomous Multi-Agent Engineering Studio",
  "description": "Local-first Autonomous AI Software Engineering Studio with Ghost-Text Autocomplete, SAST Quick-Fix, and 5-Agent Swarm.",
  "version": "1.5.0",
  "publisher": "saleha-ai",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Saleha AI Configuration",
      "properties": {
        "saleha.ollamaEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434/api/generate",
          "description": "Local Ollama generation endpoint for Ghost-Text autocomplete."
        },
        "saleha.autocompleteModel": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b",
          "description": "Model used for fast inline code completions."
        },
        "saleha.autoCommit": {
          "type": "boolean",
          "default": true,
          "description": "Automatically create conventional commits on successful task generation."
        }
      }
    },
    "commands": [
      {
        "command": "saleha.openStudio",
        "title": "Saleha: Open Web Studio",
        "category": "Saleha AI"
      },
      {
        "command": "saleha.runSwarm",
        "title": "Saleha: Run 5-Stage Swarm Delivery",
        "category": "Saleha AI"
      },
      {
        "command": "saleha.auditSecurity",
        "title": "Saleha: Run AST Security SAST Audit",
        "category": "Saleha AI"
      },
      {
        "command": "saleha.generatePR",
        "title": "Saleha: Generate Autonomous PR",
        "category": "Saleha AI"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "saleha.auditSecurity",
          "group": "SalehaAI@1"
        },
        {
          "command": "saleha.runSwarm",
          "group": "SalehaAI@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "saleha-sidebar",
          "title": "Saleha AI",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "saleha-sidebar": [
        {
          "type": "webview",
          "id": "saleha.webview",
          "name": "Saleha AI Studio"
        }
      ]
    }
  }
}
