---
// Saleha AI - 100/100 Lighthouse Astro 5 Landing Page with 3D WebGL & Modern Agent UI Layout
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Saleha AI — Sovereign Autonomous AI Software Engineer ($0/mo Local)</title>
  <meta name="description" content="Local-first autonomous multi-agent coding platform powered by Ollama. 19 Specialized Python Agents, Universal MCP Hub, and sub-100μs deterministic AST verification.">
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  
  <!-- Three.js for 3D Neural Swarm Canvas -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <style>
    :root {
      --bg-base: #06080d;
      --bg-surface: #0c101a;
      --bg-elevated: #131929;
      --bg-hover: #1b233a;
      --accent: #38bdf8;
      --accent-glow: rgba(56, 189, 248, 0.35);
      --accent-purple: #818cf8;
      --accent-green: #10b981;
      --text-bright: #f8fafc;
      --text-main: #cbd5e1;
      --text-dim: #64748b;
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-bright: rgba(56, 189, 248, 0.4);
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'Fira Code', monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; color-scheme: dark; }

    body {
      background-color: var(--bg-base);
      color: var(--text-main);
      font-family: var(--font-sans);
      min-height: 100vh;
      overflow-x: hidden;
      line-height: 1.6;
    }

    /* 3D WebGL Canvas Background */
    #hero-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 750px;
      z-index: 0;
      pointer-events: none;
      opacity: 0.55;
    }

    /* Navigation Header */
    header {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 1.25rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: relative;
      z-index: 10;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      font-size: 1.15rem;
      font-weight: 900;
      color: var(--text-bright);
      text-decoration: none;
      letter-spacing: -0.02em;
    }

    .logo-icon {
      width: 32px;
      height: 32px;
      background: linear-gradient(135deg, var(--accent), var(--accent-purple));
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      color: #000;
      font-weight: 900;
      box-shadow: 0 0 16px var(--accent-glow);
    }

    nav {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      font-size: 0.85rem;
      font-weight: 600;
    }

    nav a {
      color: var(--text-dim);
      text-decoration: none;
      transition: color 0.15s ease;
    }

    nav a:hover { color: var(--text-bright); }

    .btn-launch-nav {
      background: var(--bg-elevated);
      border: 1px solid var(--border-subtle);
      color: var(--text-bright);
      padding: 0.4rem 1rem;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.8rem;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-launch-nav:hover {
      border-color: var(--accent);
      box-shadow: 0 0 12px var(--accent-glow);
    }

    /* Hero Section (Kimi-Inspired Agent Layout) */
    .hero {
      position: relative;
      z-index: 2;
      max-width: 900px;
      margin: 0 auto;
      text-align: center;
      padding: 3.5rem 1.5rem 2.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
    }

    h1.hero-title {
      font-size: clamp(3rem, 7vw, 4.8rem);
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 1;
      margin: 0;
      background: linear-gradient(135deg, var(--text-bright) 30%, var(--accent) 80%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    p.subtitle {
      font-size: 1.05rem;
      color: var(--text-dim);
      max-width: 620px;
      line-height: 1.5;
      font-weight: 500;
    }

    /* Floating Omnibox Card */
    .omnibox-card {
      width: 100%;
      max-width: 760px;
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 16px;
      padding: 1rem 1.25rem;
      box-shadow: 0 12px 45px rgba(0,0,0,0.55);
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      text-align: left;
      margin-top: 0.75rem;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .omnibox-card:focus-within {
      border-color: var(--accent);
      box-shadow: 0 16px 60px rgba(0,0,0,0.7), 0 0 25px var(--accent-glow);
    }

    .omnibox-textarea {
      width: 100%;
      height: 70px;
      background: transparent;
      border: none;
      outline: none;
      color: var(--text-bright);
      font-family: inherit;
      font-size: 0.95rem;
      line-height: 1.5;
      resize: none;
    }

    .omnibox-textarea::placeholder { color: #475569; }

    .omnibox-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-top: 1px solid var(--border-subtle);
      padding-top: 0.75rem;
    }

    .btn-plus-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: var(--bg-elevated);
      border: 1px solid var(--border-subtle);
      color: var(--text-bright);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 1rem;
      font-weight: 700;
    }

    .btn-send-circle {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--accent);
      color: #000;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      font-size: 1.1rem;
      cursor: pointer;
      box-shadow: 0 0 14px var(--accent-glow);
      transition: transform 0.2s;
    }
    .btn-send-circle:hover { transform: scale(1.06); }

    /* Quick Action Capability Pills */
    .pills-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      max-width: 760px;
      margin-top: 0.25rem;
    }

    .pill-btn {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.35rem;
      text-decoration: none;
      transition: all 0.2s;
    }
    .pill-btn:hover {
      border-color: var(--accent);
      color: var(--text-bright);
      background: var(--bg-elevated);
      transform: translateY(-1px);
    }

    /* Feature Grid Section */
    .features-section {
      max-width: 1100px;
      margin: 4rem auto 0;
      padding: 0 1.5rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.25rem;
      position: relative;
      z-index: 2;
    }

    .feature-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 1.5rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .feature-icon {
      font-size: 1.75rem;
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: var(--bg-elevated);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border-subtle);
    }

    .feature-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-bright);
    }

    .feature-desc {
      font-size: 0.82rem;
      color: var(--text-dim);
      line-height: 1.5;
    }

    /* Footer */
    footer {
      max-width: 1100px;
      margin: 5rem auto 2rem;
      padding: 1.5rem;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.8rem;
      color: var(--text-dim);
      position: relative;
      z-index: 2;
    }
  </style>
</head>
<body>

  <!-- Three.js Canvas -->
  <div id="hero-canvas"></div>

  <!-- Header Navigation -->
  <header>
    <a href="#" class="logo">
      <div class="logo-icon">S</div>
      <span>SALEHA AI</span>
    </a>

    <nav>
      <a href="#features">Capabilities</a>
      <a href="#benchmarks">Benchmarks</a>
      <a href="http://localhost:3000" class="btn-launch-nav">Launch Web Studio ↗</a>
    </nav>
  </header>

  <!-- Hero Section -->
  <main class="hero">
    <h1 class="hero-title">SALEHA</h1>
    <p class="subtitle">
      Sovereign Autonomous AI Software Engineer • 19-Agent Swarm • $0/mo Private Offline Subsystem
    </p>

    <!-- Floating Omnibox Card (Kimi-Inspired) -->
    <div class="omnibox-card">
      <textarea
        class="omnibox-textarea"
