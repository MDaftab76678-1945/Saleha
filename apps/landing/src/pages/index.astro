        </tr>
        <tr>
          <td>Cursor IDE</td>
          <td>$20 / Month</td>
          <td>Cloud LLM Proxied</td>
          <td>Language Server</td>
          <td>Single Assistant</td>
        </tr>
      </tbody>
    </table>
  </section>

  <footer>
    <p>© 2026 Saleha AI Open Source Initiative. Released under Apache 2.0 / MIT License.</p>
    <p style="margin-top:0.5rem; color:var(--text-dim);">Engineered with Local LLM Privacy & Sovereign 3D WebGL Technology.</p>
  </footer>

  <!-- 3D Three.js WebGL Script & Theme Switcher Logic -->
  <script>
    // Theme Engine Switcher
    const themeSelector = document.getElementById('themeSelector');
    const themes = {
      obsidian: { bgBase: '#06080d', bgSurface: '#0c101a', bgElevated: '#131929', accent: '#38bdf8', textBright: '#f8fafc', borderBright: 'rgba(56, 189, 248, 0.4)' },
      oled: { bgBase: '#000000', bgSurface: '#080808', bgElevated: '#121212', accent: '#38bdf8', textBright: '#ffffff', borderBright: '#ffffff' },
      cyber: { bgBase: '#050510', bgSurface: '#0a0a23', bgElevated: '#14143c', accent: '#00ffcc', textBright: '#ffffff', borderBright: '#00ffcc' },
      aurora: { bgBase: '#04130e', bgSurface: '#09221b', bgElevated: '#0f3329', accent: '#10b981', textBright: '#f0fdf4', borderBright: '#10b981' },
      matrix: { bgBase: '#020a04', bgSurface: '#06150a', bgElevated: '#0c2512', accent: '#00ff41', textBright: '#50fa7b', borderBright: '#00ff41' },
      hyperlight: { bgBase: '#f8fafc', bgSurface: '#ffffff', bgElevated: '#f1f5f9', accent: '#0284c7', textBright: '#0f172a', borderBright: '#0284c7' }
    };

    if (themeSelector) {
      themeSelector.addEventListener('change', (e) => {
        const t = themes[e.target.value] || themes.obsidian;
        document.documentElement.style.setProperty('--bg-base', t.bgBase);
        document.documentElement.style.setProperty('--bg-surface', t.bgSurface);
        document.documentElement.style.setProperty('--bg-elevated', t.bgElevated);
        document.documentElement.style.setProperty('--accent', t.accent);
        document.documentElement.style.setProperty('--text-bright', t.textBright);
        document.documentElement.style.setProperty('--border-bright', t.borderBright);
      });
    }

    // 3D Three.js WebGL Particle Network
    const canvas = document.getElementById('hero-canvas');
    if (canvas && typeof THREE !== 'undefined') {
      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(60, window.innerWidth / 700, 0.1, 1000);
      camera.position.z = 25;

      const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
      renderer.setSize(window.innerWidth, 700);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

      // Icosahedron Core Node
      const geometry = new THREE.IcosahedronGeometry(7, 2);
      const wireMaterial = new THREE.MeshBasicMaterial({ color: 0x38bdf8, wireframe: true, transparent: true, opacity: 0.25 });
      const coreMesh = new THREE.Mesh(geometry, wireMaterial);
      scene.add(coreMesh);

      // Floating Particle Cloud
      const particleCount = 200;
      const particleGeo = new THREE.BufferGeometry();
      const positions = new Float32Array(particleCount * 3);
      for (let i = 0; i < particleCount * 3; i++) {
        positions[i] = (Math.random() - 0.5) * 50;
      }
      particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      const particleMat = new THREE.PointsMaterial({ color: 0x818cf8, size: 0.35, transparent: true, opacity: 0.7 });
      const particleSystem = new THREE.Points(particleGeo, particleMat);
      scene.add(particleSystem);

      // Mouse interaction
      let mouseX = 0, mouseY = 0;
      window.addEventListener('mousemove', (e) => {
        mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
        mouseY = (e.clientY / window.innerHeight - 0.5) * 2;
      });

      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / 700;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, 700);
      });

      const animate = () => {
        requestAnimationFrame(animate);
        coreMesh.rotation.x += 0.002;
        coreMesh.rotation.y += 0.003;
        particleSystem.rotation.y -= 0.001;
        coreMesh.rotation.x += (mouseY * 0.5 - coreMesh.rotation.x) * 0.05;
        coreMesh.rotation.y += (mouseX * 0.5 - coreMesh.rotation.y) * 0.05;
        renderer.render(scene, camera);
      };
      animate();
    }
  </script>
</body>
</html>
