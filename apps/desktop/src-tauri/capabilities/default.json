{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window: local filesystem access and permission to spawn the bundled saleha backend sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "saleha",
          "sidecar": true,
          "args": [
            "serve",
            "--host",
            "127.0.0.1",
            "--port",
            { "validator": "^\\d{1,5}$" },
            "--no-open"
          ]
        }
      ]
    }
  ]
}
