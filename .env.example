# Saleha AI — Environment Configuration Blueprint (.env.example)
# Copy this file to .env and adjust the values for your local environment.

# ==============================================================================
# 1. Local Ollama Runtime & Networking
# ==============================================================================
# Host binding for Ollama API. Always use client address (127.0.0.1) with scheme.
# Never use 0.0.0.0 directly as client URL.
OLLAMA_HOST=http://127.0.0.1:11434

# Default fast coder model (3B parameter tier, low VRAM footprint)
SALEHA_DEFAULT_MODEL=qwen2.5-coder:3b

# Reasoning flagship model (8B parameter tier, architectural tasks)
SALEHA_REASONING_MODEL=qwen3:8b

# Embedding model for BM25 and semantic memory indexing
SALEHA_EMBEDDING_MODEL=nomic-embed-text

# ==============================================================================
# 2. Execution Security & Permissions
# ==============================================================================
# Approval gating level:
# - dangerous : prompts before file deletion, git reset, or disk-modifying ops
# - always    : prompts before every single tool action
# - never     : full autonomy (use strictly in isolated temporary containers)
SALEHA_APPROVAL=dangerous

# Environment mode: development | production | test
SALEHA_ENV=development

# ==============================================================================
# 3. System Console & Encoding Invariants
# ==============================================================================
# Critical on Windows cp1252 consoles to prevent crash on non-ASCII output.
PYTHONIOENCODING=utf-8

# Log verbosity: DEBUG | INFO | WARNING | ERROR
SALEHA_LOG_LEVEL=INFO

# ==============================================================================
# 4. Sandbox & Resource Limits
# ==============================================================================
# Subprocess execution timeout in seconds
SALEHA_SANDBOX_TIMEOUT_SEC=300

# Maximum steps for autonomous AgentLoop before forced termination
SALEHA_MAX_STEPS=15

# Enforce real tool execution before allowing finish() (1 = enabled, 0 = disabled)
SALEHA_MIN_ACTIONS_BEFORE_FINISH=1
